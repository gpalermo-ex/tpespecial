package views

import (
	"fmt"
	"tpespecial/servidor-musica/db/sqlc"
)

templ RegisterList(albums []db.Album) {
	<section id="register-list">
		<p id="form-error" role="alert" style="color: red;"></p>
		<h2>Colección de Álbumes</h2>
		if len(albums) == 0 {
			<p>No hay álbumes en el catálogo.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th scope="col">Album</th>
						<th scope="col">Usuario</th>
						<th scope="col">Título</th>
						<th scope="col">Artista</th>
						<th scope="col">Género</th>
						<th scope="col">Duración</th>
						<th scope="col">Rating</th>
						<th scope="col">Fecha creacion</th>
					</tr>
				</thead>
				<tbody>
					for _, album := range albums {
						<tr>
							<td>{ fmt.Sprint(album.IDAlbum) }</td>
							<td>{ fmt.Sprint(album.IDUsuario) }</td>
							<td><strong>{ album.Titulo }</strong></td>
							<td>{ album.Artista }</td>
							<td>{ album.Genero }</td>
							<td>{ fmt.Sprint(album.DuracionMin) } min</td>
							<td>{ fmt.Sprint(album.Rating) }/5</td>
							<td>
								if album.CreatedAt.Valid {
									{ album.CreatedAt.Time.Format("02/01/2006 15:04") }
								} else {
									-
								}
							</td>
							<td>
								<button
									hx-delete={ fmt.Sprintf("/albums/%d", album.IDRegistro) }
									hx-target="closest tr"
									hx-swap="outerHTML"
									hx-confirm="¿Estás seguro de que deseas eliminar este registro?">	
									Borrar
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}